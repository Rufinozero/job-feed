# Copie para .env e preencha. O .env nunca vai para o git.
APP_ENV=dev
LOG_LEVEL=INFO
# Opcionais (padrões em src/app/config.py)
SITES=linkedin,glassdoor,indeed
SEARCH_TERMS=analista de arquitetura,arquiteta,arquiteto,projetista de arquitetura,assistente de arquitetura,cadista,desenhista
